        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 47
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (span_name) (max_over_time(traces_spanmetrics_latency_sum{service=\"kcp\", span_name=~\"(gateway|offset|clusterlink|migplan|groupoffsets|d2s|wait)\\\\..*\"}[$__range])) / sum by (span_name) (max_over_time(traces_spanmetrics_latency_count{service=\"kcp\", span_name=~\"(gateway|offset|clusterlink|migplan|groupoffsets|d2s|wait)\\\\..*\"}[$__range]))",
          "instant": true,
          "range": false,
