    {
      "id": 102,
      "type": "row",
      "title": "Across all runs (since the backend started)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 46
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Mean time per step",
      "description": "Mean duration of each step.* span over every traced run.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 47
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (span_name) (max_over_time(traces_spanmetrics_latency_sum{service=\"kcp\", span_name=~\"step\\\\..*\"}[$__range])) / sum by (span_name) (max_over_time(traces_spanmetrics_latency_count{service=\"kcp\", span_name=~\"step\\\\..*\"}[$__range]))",
          "instant": true,
          "range": false,
          "legendFormat": "{{span_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "continuous-BlYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "text",
        "namePlacement": "left",
        "sizing": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Mean time per operation",
      "description": "Mean duration of the inner operations (gateway, offset, cluster-link, reconcile reads, waits) over every traced run.",
