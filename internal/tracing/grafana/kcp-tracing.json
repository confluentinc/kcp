    {
      "id": 12,
      "type": "bargauge",
      "title": "Calls per operation",
      "description": "How many times each step and operation ran, over every traced run.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
