# TBM halt — a static route with no pre-staged redundant auth for the target
# domain (HERMETIC).
#
# route names "static-route", which exists only in gateway-static-probe.yaml. The
# halt sub-test drives this against that fixture via
# migplan.WithGatewaySource(NewGatewayFile(gateway-static-probe.yaml, "static-route")),
# so the live tbm-route stays valid. static-route has no security.cluster.
# destination-domain block, so the engine refuses on the failed precondition
# "route carries pre-staged auth for the target domain"
# (reconcile/staticpreconditions.go) — the static-route strategy dispatches on
# mode == "static" (reconcile/reconcile.go) before the dynamic-only "route is
# dynamic" check ever runs. The topic selection is incidental (the shape check
# refuses first).
apiVersion: kcp.confluent.io/v1alpha1
kind: GatewayMigration
metadata:
  name: tbm-halt-route-missing-staged-auth
spec:
  source:
    type: apache-kafka
    bootstrapServers:
      - "__SOURCE_BOOTSTRAP__"
    credentials: __CRED_DIR__/source-creds.yaml
  target:
    type: confluent-platform
    clusterId: "__DEST_CLUSTER_ID__"
    kafka:
      bootstrapServers:
        - "__DEST_BOOTSTRAP__"
      restEndpoint: "__REST_ENDPOINT__"
      clusterCredentials: __CRED_DIR__/dest-kafka-creds.yaml
  clusterLink:
    name: "__CLUSTER_LINK_NAME__"
    bootstrapServers:
      - "__DEST_BOOTSTRAP__"
    linkCredentials: __CRED_DIR__/link-creds.yaml
  gateway:
    namespace: "__NAMESPACE__"
    cr-name: "__GATEWAY_NAME__"
  route:
    name: "static-route"
    topicGroup:
      - topics:
          - "tbm-topic-046"
    targetStreamingDomain: "__DEST_DOMAIN__"
