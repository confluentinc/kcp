# TBM halt — source topic that is not on the cluster link.
#
# Selects tbm-topic-049, which exists on the source but is un-mirrored (the link
# mirrors only 001-048). The engine fails fast per-topic: res.Reasons contains
# "is not on the cluster link" (reconcile/verdict.go). Runs against the LIVE gateway.
apiVersion: kcp.confluent.io/v1alpha1
kind: GatewayMigration
metadata:
  name: tbm-halt-unmirrored
spec:
  source:
    type: apache-kafka
    bootstrapServers:
      - "__SOURCE_BOOTSTRAP__"
    credentials: __CRED_DIR__/source-creds.yaml
  target:
    type: confluent-platform
    clusterId: "__DEST_CLUSTER_ID__"
    kafka:
      bootstrapServers:
        - "__DEST_BOOTSTRAP__"
      restEndpoint: "__REST_ENDPOINT__"
      clusterCredentials: __CRED_DIR__/dest-kafka-creds.yaml
  clusterLink:
    name: "__CLUSTER_LINK_NAME__"
    bootstrapServers:
      - "__DEST_BOOTSTRAP__"
    linkCredentials: __CRED_DIR__/link-creds.yaml
  gateway:
    namespace: "__NAMESPACE__"
    cr-name: "__GATEWAY_NAME__"
  topicGroup:
    - topics:
        - "tbm-topic-049"
      route: "__ROUTE_NAME__"
      targetStreamingDomain: "__DEST_DOMAIN__"
