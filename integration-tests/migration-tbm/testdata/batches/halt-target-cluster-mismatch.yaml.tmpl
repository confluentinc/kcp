# TBM halt — declared target clusterId does not match the live target cluster.
#
# spec.target.clusterId is the wrong literal "lkc-wrongwrong" (deliberately NOT the
# __DEST_CLUSTER_ID__ placeholder). The engine refuses on the failed precondition
# "target cluster matches the manifest", detail 'spec.target.clusterId is
# "lkc-wrongwrong", but the target cluster reports "<id>"' (reconcile/preconditions.go).
# Runs against the LIVE gateway.
apiVersion: kcp.confluent.io/v1alpha1
kind: GatewayMigration
metadata:
  name: tbm-halt-target-cluster-mismatch
spec:
  source:
    type: apache-kafka
    bootstrapServers:
      - "__SOURCE_BOOTSTRAP__"
    credentials: __CRED_DIR__/source-creds.yaml
  target:
    type: confluent-platform
    clusterId: "lkc-wrongwrong"
    kafka:
      bootstrapServers:
        - "__DEST_BOOTSTRAP__"
      restEndpoint: "__REST_ENDPOINT__"
      clusterCredentials: __CRED_DIR__/dest-kafka-creds.yaml
  clusterLink:
    name: "__CLUSTER_LINK_NAME__"
    bootstrapServers:
      - "__DEST_BOOTSTRAP__"
    linkCredentials: __CRED_DIR__/link-creds.yaml
  gateway:
    namespace: "__NAMESPACE__"
    cr-name: "__GATEWAY_NAME__"
  topicGroup:
    - topics:
        - "tbm-topic-046"
      route: "__ROUTE_NAME__"
      targetStreamingDomain: "__DEST_DOMAIN__"
