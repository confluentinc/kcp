# TBM halt — the named route does not bind exactly two domains (HERMETIC).
#
# route names "single-domain-route", which exists only in gateway-static-probe.yaml
# and is a dynamic route bound to a single streaming domain. The halt sub-test drives
# this against that fixture via
# migplan.WithGatewaySource(NewGatewayFile(gateway-static-probe.yaml, "single-domain-route")),
# so the live tbm-route stays valid. The engine refuses on the failed precondition
# "route binds exactly two domains" (reconcile/preconditions.go). The topic selection
# is incidental (the shape check refuses first).
apiVersion: kcp.confluent.io/v1alpha1
kind: GatewayMigration
metadata:
  name: tbm-halt-route-binds-two-domains
spec:
  source:
    type: apache-kafka
    bootstrapServers:
      - "__SOURCE_BOOTSTRAP__"
    credentials: __CRED_DIR__/source-creds.yaml
  target:
    type: confluent-platform
    clusterId: "__DEST_CLUSTER_ID__"
    kafka:
      bootstrapServers:
        - "__DEST_BOOTSTRAP__"
      restEndpoint: "__REST_ENDPOINT__"
      clusterCredentials: __CRED_DIR__/dest-kafka-creds.yaml
  clusterLink:
    name: "__CLUSTER_LINK_NAME__"
    bootstrapServers:
      - "__DEST_BOOTSTRAP__"
    linkCredentials: __CRED_DIR__/link-creds.yaml
  gateway:
    namespace: "__NAMESPACE__"
    cr-name: "__GATEWAY_NAME__"
  topicGroup:
    - topics:
        - "tbm-topic-046"
      route: "single-domain-route"
      targetStreamingDomain: "__DEST_DOMAIN__"
