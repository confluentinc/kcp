# TBM halt — the manifest asks for the consumer offset-sync pause on a dynamic route.
#
# Selects a valid mirrored headroom topic; the trigger is run-level, not the topic.
# A dynamic route requires the link's consumer offset sync to be off, so there is
# nothing to pause: Decide refuses on the failed precondition "offset-sync pause
# not requested" (reconcile/preconditions.go). Runs against the LIVE gateway.
apiVersion: kcp.confluent.io/v1alpha1
kind: GatewayMigration
metadata:
  name: tbm-halt-offset-sync-pause-requested
spec:
  source:
    type: apache-kafka
    bootstrapServers:
      - "__SOURCE_BOOTSTRAP__"
    credentials: __CRED_DIR__/source-creds.yaml
  target:
    type: confluent-platform
    clusterId: "__DEST_CLUSTER_ID__"
    kafka:
      bootstrapServers:
        - "__DEST_BOOTSTRAP__"
      restEndpoint: "__REST_ENDPOINT__"
      clusterCredentials: __CRED_DIR__/dest-kafka-creds.yaml
  clusterLink:
    name: "__CLUSTER_LINK_NAME__"
    bootstrapServers:
      - "__DEST_BOOTSTRAP__"
    linkCredentials: __CRED_DIR__/link-creds.yaml
    pauseConsumerOffsetSync: true
    consumerOffsetSyncBaseline: enabled
  gateway:
    namespace: "__NAMESPACE__"
    cr-name: "__GATEWAY_NAME__"
  route:
    name: "__ROUTE_NAME__"
    topicGroup:
      - topics:
          - "tbm-topic-046"
    targetStreamingDomain: "__DEST_DOMAIN__"
