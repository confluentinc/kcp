# Rendered by renderGatewayMigration in manifest_fixture_test.go and written into
# the runner pod at /workspace/gateway-migration-<scenario>.yaml.
#
# Every credentials slot is a PATH to a credentials file; inline secret blocks
# are not accepted, so this manifest carries no secret material itself. The
# referenced files are rendered separately (renderCredentialFiles) and written
# alongside the manifest.
apiVersion: kcp.confluent.io/v1alpha1
kind: GatewayMigration

metadata:
  name: {{ .MetadataName | yamlQuote }}

spec:
  source:
    # The e2e source is a CFK Kafka cluster, not MSK. The value is load-bearing:
    # it gates `iam` to msk-only.
    type: apache-kafka
    bootstrapServers:
      - {{ .SourceBootstrap | yamlQuote }}
    credentials: {{ .SourceCredPath | yamlQuote }}

  target:
    # confluent-platform with an explicit clusterId — required for both target
    # types in this kind, and the reason decision 25 exists.
    type: confluent-platform
    clusterId: {{ .DestClusterID | yamlQuote }}
    kafka:
      bootstrapServers:
        - {{ .DestBootstrap | yamlQuote }}
      restEndpoint: {{ .RestEndpoint | yamlQuote }}
      clusterCredentials: {{ .DestKafkaCredPath | yamlQuote }}

  clusterLink:
    name: {{ .ClusterLinkName | yamlQuote }}
    # Repeats spec.target.kafka.bootstrapServers for self-documentation.
    bootstrapServers:
      - {{ .DestBootstrap | yamlQuote }}
    # The cluster-link REST credential, always required (never derived).
    linkCredentials: {{ .LinkCredPath | yamlQuote }}
{{- if .PauseConsumerOffsetSync }}
    pauseConsumerOffsetSync: true
{{- end }}

  gateway:
    namespace: {{ .Namespace | yamlQuote }}
    kubeconfig: {{ .KubePath | yamlQuote }}
    cr-name: {{ .GatewayName | yamlQuote }}
  topicGroup:
{{- range .FenceRoutes }}
      # A match-all pattern migrates every active mirror topic — the behaviour
      # the old omitted spec.topics gave. The bootstrap server id is derived from
      # the target domain's declaration in the live CR, not written here.
    - topicPatterns:
        - {{ ".*" | yamlQuote }}
      route: {{ .Name | yamlQuote }}
      targetStreamingDomain: {{ .SwitchoverDomainName | yamlQuote }}
{{- end }}
{{- if .Policy.Any }}

  # Read FRESH by execute on every run and never snapshotted, which is what lets a
  # scenario re-render this file between init and execute. Every knob is emitted
  # only when non-zero: an absent key already means the zero the retired flags
  # defaulted to, and a literal 0 would not match the schema's duration pattern.
  defaultPolicies:
{{- if .Policy.LagThreshold }}
    lagThreshold: {{ .Policy.LagThreshold }}
{{- end }}
{{- if .Policy.PromoteBatchSize }}
    promoteBatchSize: {{ .Policy.PromoteBatchSize }}
{{- end }}
{{- if .Policy.RolloutTimeout }}
    rolloutTimeout: {{ .Policy.RolloutTimeout }}
{{- end }}
{{- if .Policy.DetectUnroutedProducers }}
    detectUnroutedProducersDuration: {{ .Policy.DetectUnroutedProducers }}
{{- end }}
{{- if .Policy.ConsumerOffsetSyncDrain }}
    consumerOffsetSyncDrainDuration: {{ .Policy.ConsumerOffsetSyncDrain }}
{{- end }}
{{- end }}
